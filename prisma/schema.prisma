datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MERCHANT
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum EnvironmentMode {
  SANDBOX
  LIVE
}

enum PaymentProvider {
  BKASH
  NAGAD
  ROCKET
}

enum TransactionStatus {
  INITIALIZED
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(MERCHANT)
  status        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  merchant      Merchant?
  auditLogs     AuditLog[]

  @@map("users")
}

model Merchant {
  id               String          @id @default(uuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  businessName     String
  slug             String          @unique
  status           MerchantStatus  @default(PENDING)
  
  // Webhook settings
  webhookUrl       String?
  webhookSecret    String          
  
  // Markup fee configuration
  feePercentage    Decimal         @default(0.50) @db.Decimal(5, 2)
  fixedFee         Decimal         @default(0.00) @db.Decimal(10, 2)
  
  apiKeys          ApiKey[]
  bkashConfigs     BkashConfig[]
  providerConfigs  ProviderConfig[]
  transactions     Transaction[]
  webhookLogs      WebhookLog[]
  refunds          Refund[]
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("merchants")
}

model ApiKey {
  id           String          @id @default(uuid())
  merchantId   String
  merchant     Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  
  name         String          
  keyPrefix    String          
  keyHash      String          @unique 
  mode         EnvironmentMode @default(SANDBOX)
  isRevoked    Boolean         @default(false)
  lastUsedAt   DateTime?
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([keyPrefix])
  @@map("api_keys")
}

model BkashConfig {
  id                   String          @id @default(uuid())
  merchantId           String?         
  merchant             Merchant?       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  
  mode                 EnvironmentMode @default(SANDBOX)
  isSystemDefault      Boolean         @default(false)
  
  appKey               String          
  appSecretEncrypted   String          
  usernameEncrypted    String          
  passwordEncrypted    String          
  
  iv                   String          
  tag                  String          
  
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("bkash_configs")
}

model ProviderConfig {
  id                   String          @id @default(uuid())
  merchantId           String?         
  merchant             Merchant?       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  
  provider             PaymentProvider
  mode                 EnvironmentMode @default(SANDBOX)
  isSystemDefault      Boolean         @default(false)
  
  // Encrypted Credentials Vault (AES-256-GCM)
  credentialsEncrypted String          
  iv                   String
  tag                  String
  
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("provider_configs")
}

model Transaction {
  id                   String            @id @default(uuid())
  transactionId        String            @unique 
  
  merchantId           String
  merchant             Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  
  merchantInvoiceNo    String            
  provider             PaymentProvider   @default(BKASH)
  
  bkashPaymentID       String?           @unique 
  bkashTrxID           String?           @unique 
  providerTrxID        String?           // Generic provider transaction ID (Nagad / Rocket)
  
  amount               Decimal           @db.Decimal(12, 2)
  currency             String            @default("BDT")
  feeAmount            Decimal           @default(0.00) @db.Decimal(12, 2)
  netAmount            Decimal           @default(0.00) @db.Decimal(12, 2)
  
  status               TransactionStatus @default(INITIALIZED)
  mode                 EnvironmentMode   @default(SANDBOX)
  
  intent               String            @default("sale")
  payerReference       String?           
  customerMobile       String?           
  
  callbackUrl          String            
  cancelUrl            String?
  metadata             Json?             
  
  failureReason        String?
  
  webhookLogs          WebhookLog[]
  refunds              Refund[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([merchantId, status])
  @@index([bkashPaymentID])
  @@index([merchantInvoiceNo])
  @@map("transactions")
}

model WebhookLog {
  id             String        @id @default(uuid())
  merchantId     String
  merchant       Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  
  transactionId  String
  transaction    Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  event          String        
  endpointUrl    String
  payload        Json
  signature      String        
  
  httpStatus     Int?
  responseBody   String?
  attemptCount   Int           @default(0)
  maxAttempts    Int           @default(5)
  nextRetryAt    DateTime?
  status         WebhookStatus @default(PENDING)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, nextRetryAt])
  @@map("webhook_logs")
}

model Refund {
  id               String      @id @default(uuid())
  merchantId       String
  merchant         Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  
  transactionId    String
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  bkashRefundTrxID String?     @unique
  amount           Decimal     @db.Decimal(12, 2)
  reason           String?
  status           String      @default("COMPLETED")
  
  createdAt        DateTime    @default(now())

  @@map("refunds")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action    String   
  ipAddress String?
  userAgent String?
  details   Json?
  
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
